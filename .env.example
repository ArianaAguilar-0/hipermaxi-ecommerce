# Copia este archivo como .env.local (ignorado por git) y completa los valores.
# Estas variables NO llevan prefijo VITE_: solo las usa el proxy de Vite (vite.config.js)
# y nunca llegan al navegador.

# URL base de tu Dolibarr, SIN /api/index.php y sin "/" al final.
# Ejemplo: DOLIBARR_URL=https://miempresa.with11.dolicloud.com
DOLIBARR_URL=

# API key del usuario de servicio de Dolibarr (se envía como header DOLAPIKEY)
DOLIBARR_API_KEY=
